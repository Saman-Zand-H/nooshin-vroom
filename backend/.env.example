DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
FRONTEND_ORIGINS=https://your-frontend.example.com
DATABASE_URL=postgresql://user:password@host:5432/control_room
DATABASE_SSLMODE=require
DJANGO_COOKIE_SECURE=true
DJANGO_COOKIE_SAMESITE=None
DJANGO_CSRF_SAMESITE=None
DJANGO_HSTS_SECONDS=31536000
DJANGO_SSL_REDIRECT=true
DJANGO_DEFAULT_FROM_EMAIL=room@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
APP_URL=https://your-frontend.example.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-api.example.com/api/spotify/callback/
# Register every exact callback below in Spotify; localhost and 127.0.0.1 can coexist.
SPOTIFY_REDIRECT_URIS=http://localhost:5188/api/spotify/callback/,http://127.0.0.1:5188/api/spotify/callback/
# Generate with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SPOTIFY_TOKEN_KEY=replace-with-a-fernet-key
IMDB_WATCHLIST_QUERY_HASH=
