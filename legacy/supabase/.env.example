# Edge Function secrets only. Set in Supabase; NEVER prefix these with VITE_.
APP_URL=https://your-app.example/
SPOTIFY_CLIENT_ID=
# Server-only Spotify app secret. Never prefix with VITE_ or ship to the browser.
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-project.supabase.co/functions/v1/spotify/callback
# Base64 encoded random 32-byte key, used for AES-GCM token encryption.
SPOTIFY_TOKEN_KEY=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself.

# Public Watchlist connection. No IMDb account/password/API key is needed.
IMDB_WATCHLIST_ENABLED=true
# Optional override when IMDb changes its persisted website query.
IMDB_WATCHLIST_QUERY_HASH=
# Random 32+ character secret, also stored in Supabase Vault for pg_cron.
IMDB_CRON_SECRET=
