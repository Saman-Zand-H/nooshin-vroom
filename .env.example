# Empty config is locked. Opt into the seeded device preview explicitly below.
VITE_BASE_PATH=/
# Local-only seeded room. Must stay false/empty for every hosted build.
VITE_LOCAL_PREVIEW=false

# Django API origin. Leave empty when Django serves the frontend on the same origin.
VITE_DJANGO_API_URL=http://127.0.0.1:8000
VITE_DJANGO_SAME_ORIGIN=false
